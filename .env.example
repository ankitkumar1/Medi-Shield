# Copy to .env and fill in. Never commit .env.

# Optional. When set, the classifier sends the page image to Groq.
# Leave blank to keep the local Tesseract classifier.
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000

# Local stand-in for S3 until MinIO is wired.
STORAGE_DIR=data/raw

# Member records and claim history (created in a later step).
DATABASE_URL=sqlite:///./data/medishield.db
