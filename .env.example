# Copy to .env and fill in. Never commit .env.

# Vision model used by the classifier and OCR fallback.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000

# Local stand-in for S3 until MinIO is wired.
STORAGE_DIR=data/raw

# Member records and claim history (created in a later step).
DATABASE_URL=sqlite:///./data/medishield.db
